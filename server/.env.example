# Server
PORT=5000
NODE_ENV=development

# MongoDB (leave unset to use an in-memory database that resets on restart)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wedding-rsvp

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+972535666298
TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App
CLIENT_URL=http://localhost:5173
RSVP_BASE_URL=http://localhost:5173

# Couple Info (used in messages)
COUPLE_NAMES=עידן וליאל
WEDDING_DATE=15.8.2025
